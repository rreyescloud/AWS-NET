<mxfile host="drawio-plugin" modified="2026-09-23T12:00:00.000Z" agent="Mozilla/5.0" version="22.1.22" etag="NET014-x402" type="embed">
  <diagram name="NET-014: WAF AI traffic monetization over x402" id="net014-x402">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="NET-014: AWS WAF AI traffic monetization — the 402 → pay → 200 loop" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="350" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Bot Control adds a third outcome next to allow and block: charge for access. Settlement happens inside a single request cycle." style="text;html=1;fontSize=11;align=center;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="350" y="50" width="1000" height="20" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="bot" value="AI bot / agent&#xa;User-Agent matched by&#xa;bot:category:ai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="80" y="180" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="cf" value="CloudFront distribution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="180" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="waf" value="AWS WAF Web ACL&#xa;Bot Control (Targeted)&#xa;rule action: Monetize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="250" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="origin" value="S3 origin&#xa;premium content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="400" y="345" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="facilitator" value="x402 facilitator&#xa;verifies the signed authorization&#xa;and settles on-chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="740" y="245" width="210" height="80" as="geometry" />
        </mxCell>

        <mxCell id="chain" value="Base Sepolia (testnet)&#xa;USDC transfer, EIP-3009&#xa;payer → payTo wallet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1110" y="245" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Flow arrows -->
        <mxCell id="e1" value="1. GET /premium.txt" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;fontSize=10;" parent="1" source="bot" target="cf" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="2. HTTP 402 Payment Required&#xa;+ challenge (price, payTo, asset)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;dashed=1;fontSize=10;exitX=0;exitY=0.5;" parent="1" source="waf" target="bot" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="285" /><mxPoint x="330" y="240" /></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="3. GET again, now carrying&#xa;the signed payment header" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;fontSize=10;" parent="1" source="bot" target="waf" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="225" /><mxPoint x="300" y="300" /></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="4. verify" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;fontSize=10;" parent="1" source="waf" target="facilitator" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="5. settle USDC" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;fontSize=10;" parent="1" source="facilitator" target="chain" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="6. fetch object" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;fontSize=10;" parent="1" source="waf" target="origin" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="7. HTTP 200 + content&#xa;+ PAYMENT-RESPONSE header (tx hash)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=3;endArrow=block;fontSize=10;" parent="1" source="origin" target="bot" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="372" /></Array></mxGeometry></mxCell>

        <!-- Contrast: human browser -->
        <mxCell id="human-box" value="For contrast — a normal browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;verticalAlign=top;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="450" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="human-detail" value="A request that does not carry an AI-bot signature never reaches the Monetize rule.&#xa;It is evaluated by the rest of the Web ACL and either served or blocked as usual —&#xa;no 402, no challenge. Monetization applies only to the bot categories you scope it to." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="100" y="485" width="465" height="70" as="geometry" />
        </mxCell>

        <!-- Three levels validated -->
        <mxCell id="levels-box" value="Three levels validated in the lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4fff4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="660" y="450" width="650" height="180" as="geometry" />
        </mxCell>
        <mxCell id="levels-detail" value="Level 1 — the challenge.  GET as an AI user-agent returns 402 with a decodable&#xa;               x402 payload. No wallet needed to prove this much.&#xa;&#xa;Level 2 — the action.  WAF logs and analytics record the Monetize action, which&#xa;               is what distinguishes it from a plain block.&#xa;&#xa;Level 3 — the full loop.  Sign, resubmit, receive 200, and confirm the USDC&#xa;               transfer landed on-chain. Balances move on both wallets." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="680" y="480" width="620" height="140" as="geometry" />
        </mxCell>

        <!-- Gotcha -->
        <mxCell id="gotcha" value="Gotcha: the payer and the payTo wallet must differ, or the facilitator rejects the settlement with self_send_not_allowed." style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="300" y="660" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Testnet only. Keys are throwaway and read from the environment, never from source." style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="300" y="695" width="1100" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
