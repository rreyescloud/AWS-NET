        <mxCell id="alb1" value="&amp;lt;alb-istio-ingress&amp;gt;&lt;br&gt;body inspected ≤ 8 KB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="alb2" value="&amp;lt;alb-k8s-ingress&amp;gt;&lt;br&gt;body inspected ≤ 8 KB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="270" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="eks" value="Amazon EKS&lt;br&gt;Istio gateway / ingress&lt;br&gt;AWS Load Balancer Controller&lt;br&gt;(wafv2-acl-arn annotation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="190" width="200" height="80" as="geometry"/>
