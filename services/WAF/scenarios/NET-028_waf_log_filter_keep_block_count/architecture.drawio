<mxfile host="app.diagrams.net">
  <diagram id="net028" name="NET-028 WAF log filter keeps BLOCK and COUNT">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="NET-028 — WAF logging filter: drop benign ALLOW traffic, keep BLOCK and every Count match" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="viewer" value="Viewers&lt;br&gt;streaming app / web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="acl" value="&lt;b&gt;web ACL&lt;/b&gt;&lt;br&gt;custom rules (some in Count)&lt;br&gt;AWS managed rule groups&lt;br&gt;(sub-rules overridden to Count)&lt;br&gt;default: Allow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="230" y="170" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="rec" value="&lt;b&gt;Log record&lt;/b&gt;&lt;br&gt;action: ALLOW&lt;br&gt;nonTerminatingMatchingRules: COUNT&lt;br&gt;ruleGroupList…COUNT (overriddenAction)&lt;br&gt;labels: awswaf:managed:aws:…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="170" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="flt" value="&lt;b&gt;Logging filter (top-down, first match)&lt;/b&gt;&lt;br&gt;1: BLOCK | COUNT | EXCLUDED_AS_COUNT&lt;br&gt;   | CAPTCHA | CHALLENGE → KEEP&lt;br&gt;default → DROP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="170" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="fh" value="&lt;b&gt;Amazon Data Firehose&lt;/b&gt;&lt;br&gt;aws-waf-logs-…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="360" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;security log archive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="470" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="drop" value="&lt;b&gt;Dropped before delivery&lt;/b&gt;&lt;br&gt;benign ALLOW (no Count match)&lt;br&gt;no Firehose / S3 cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="360" width="100" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="trap" value="&lt;b&gt;Trap&lt;/b&gt;: old filter ALLOW → DROP left on top&lt;br&gt;matches first and drops ALLOW + COUNT records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="380" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="viewer" target="acl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="decision" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="acl" target="rec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="evaluate" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="rec" target="flt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="KEEP" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#82b366;" edge="1" parent="1" source="flt" target="fh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="buffered delivery" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="fh" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="DROP" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#b85450;" edge="1" parent="1" source="flt" target="drop"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
