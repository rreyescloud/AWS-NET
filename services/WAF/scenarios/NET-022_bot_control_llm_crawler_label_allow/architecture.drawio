  <diagram name="2 — Fix and lab variant" id="net022-fix">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title2" value="NET-022 fix: CategoryAI labels only, the post-process group decides — verified AI bots by label, one interim exception by UA + IP" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="110" y="15" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle2" value="Lab variant: one account, no FMS. Two distributions share the web ACL, so the Host condition is tested the way it can actually be bypassed." style="text;html=1;fontSize=11;align=center;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="210" y="45" width="1300" height="20" as="geometry" />
        </mxCell>

        <!-- Clients -->
        <mxCell id="lab" value="Lab client&#xa;public IP in NET-022-vendor-crawlers&#xa;curl -A ExampleAIBot/1.0 · &amp;lt;ai-ua-classified&amp;gt;&#xa;python-requests · browser UA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="150" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="other" value="Other IP (e.g. CloudShell)&#xa;not in the IP set&#xa;curl -A ExampleAIBot/1.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="290" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Distributions -->
        <mxCell id="mkt" value="CloudFront · marketing&#xa;&amp;lt;marketing&amp;gt;.cloudfront.net&#xa;crawlers allowed (GET/HEAD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="330" y="150" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="portal" value="CloudFront · portal&#xa;&amp;lt;portal&amp;gt;.cloudfront.net&#xa;stands in for authenticated apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="330" y="260" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="S3 origin (private)&#xa;Origin Access Control&#xa;static index.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="330" y="420" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cwl" value="CloudWatch Logs&#xa;aws-waf-logs-net022 (1 day)&#xa;action · terminatingRuleId · labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="330" y="530" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ipset" value="IP set NET-022-vendor-crawlers&#xa;lab client /32&#xa;(stands in for 203.0.113.0/24)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="330" y="640" width="210" height="70" as="geometry" />
        </mxCell>

        <!-- Web ACL -->
        <mxCell id="acl2" value="Web ACL NET-022-acl · CLOUDFRONT · us-east-1 · default Allow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4f4;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="600" y="90" width="580" height="680" as="geometry" />
        </mxCell>
        <mxCell id="pre" value="Pre-process slot · empty (Exercise 5 moves P1 here: allowed requests then skip IP reputation and CRS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="620" y="130" width="540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bc" value="&lt;b&gt;Bot Control&lt;/b&gt; · COMMON · default version&lt;br&gt;SignalNonBrowserUserAgent → Count&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;CategoryAI → Count (step 1): still labels, no longer terminates&lt;/b&gt;&lt;/font&gt;&lt;br&gt;all other category rules → Block (python-requests still 403)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="620" y="185" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="iprep" value="AWSManagedRulesAmazonIpReputationList" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="620" y="280" width="540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="crs" value="AWSManagedRulesCommonRuleSet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="620" y="325" width="540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="post" value="Post-process group (rebuilt, step 2) · every managed group has already inspected the request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;fontStyle=1;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="620" y="380" width="540" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p0" value="&lt;b&gt;P0 ALLOW&lt;/b&gt; · Host = marketing AND Method IN (GET, HEAD)&lt;br&gt;AND ( (bot:category:ai AND (bot:verified OR bot:user_triggered:verified)) OR bot:web_bot_auth:verified )&lt;br&gt;&lt;i&gt;covers current and future verified AI crawlers, no per-vendor rule&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="640" y="415" width="500" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;P1 ALLOW (interim)&lt;/b&gt; · Host = marketing AND Method IN (GET, HEAD)&lt;br&gt;AND User-Agent CONTAINS &quot;ExampleAIBot&quot; AND source IP IN NET-022-vendor-crawlers&lt;br&gt;&lt;i&gt;UA alone is spoofable — the IP set is mandatory; removed once classified&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="640" y="490" width="500" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;P2 BLOCK&lt;/b&gt; · label bot:category:ai&lt;br&gt;&lt;i&gt;restores the CategoryAI block for unverified/spoofed AI UAs and other hosts/methods&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="640" y="565" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;P3 BLOCK&lt;/b&gt; · label signal:non_browser_user_agent AND NOT label bot:name:&amp;lt;seo-crawler&amp;gt;&lt;br&gt;&lt;i&gt;replaces the exact UA string match&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="640" y="625" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="def2" value="default action → Allow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="620" y="725" width="540" height="30" as="geometry" />
        </mxCell>

        <!-- Expected results -->
        <mxCell id="expected" value="&lt;b&gt;Expected after the fix (Exercise 3)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• ExampleAIBot · GET · lab IP · marketing → &lt;b&gt;200&lt;/b&gt; (P1)&lt;br&gt;• ExampleAIBot · other IP → &lt;b&gt;403&lt;/b&gt; (P3)&lt;br&gt;• ExampleAIBot · POST → &lt;b&gt;403&lt;/b&gt; (P3)&lt;br&gt;• ExampleAIBot · GET · portal → &lt;b&gt;403&lt;/b&gt; (P3)&lt;br&gt;• &amp;lt;ai-ua-classified&amp;gt; from lab IP → &lt;b&gt;403&lt;/b&gt; (P2, bot:unverified)&lt;br&gt;• python-requests → &lt;b&gt;403&lt;/b&gt; (CategoryHttpLibrary)&lt;br&gt;• browser UA, both distributions → &lt;b&gt;200&lt;/b&gt;&lt;br&gt;&lt;br&gt;Step 3: run P0–P3 in Count 24–48 h and read nonTerminatingMatchingRules before enforcing (Exercise 4)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="1230" y="130" width="440" height="250" as="geometry" />
        </mxCell>
        <mxCell id="cannot" value="&lt;b&gt;Not reproducible in the lab&lt;/b&gt;&lt;br&gt;bot:verified and bot:web_bot_auth:verified depend on the real crawler infrastructure (reverse DNS, published IPs, signed requests). From a lab IP a classified AI UA is always bot:unverified, so P0 is shown by design, not by test." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="1230" y="410" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="perm" value="&lt;b&gt;Permanent path&lt;/b&gt;&lt;br&gt;Request Bot Control classification for the crawler through AWS Support. Once classified and verifiable, P0 covers it and P1 is deleted. Pin or track the Bot Control version: availableLabels drifts between versions (Exercise 6)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="1230" y="540" width="440" height="100" as="geometry" />
        </mxCell>

