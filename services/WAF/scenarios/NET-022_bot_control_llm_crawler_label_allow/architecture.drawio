<mxfile host="drawio-plugin" modified="2026-10-13T12:00:00.000Z" agent="Mozilla/5.0" version="22.1.22" etag="NET022-bot-control-llm" type="embed">
  <diagram name="1 — Problem: two independent blockers" id="net022-problem">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="NET-022: LLM crawlers blocked — the custom rule, not Bot Control, stops most of them" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="260" y="15" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Blocker A: an unclassified crawler only gets signal:non_browser_user_agent and the post-process group named &quot;allow&quot; BLOCKS it. Blocker B: CategoryAI blocks classified AI bots even when verified." style="text;html=1;fontSize=11;align=center;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="110" y="45" width="1500" height="20" as="geometry" />
        </mxCell>

        <!-- Clients -->
        <mxCell id="clientA" value="Flow A · LLM crawler, unclassified&#xa;UA ExampleAIBot/1.0&#xa;from 203.0.113.0/24 (vendor range)&#xa;~90–95% of the vendor's traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="140" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="clientB" value="Flow B · LLM crawler, classified&#xa;bot:name:&amp;lt;known-ai-bot&amp;gt;&#xa;verified (real vendor infrastructure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="260" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="clientC" value="Human visitor&#xa;browser UA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="370" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- App account -->
        <mxCell id="appAcct" value="&amp;lt;ACCOUNT_APP&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="120" width="230" height="420" as="geometry" />
        </mxCell>
        <mxCell id="cf" value="CloudFront&#xa;www.example.com&#xa;(FMS policy scope)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="325" y="250" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="origin" value="Origin&#xa;open-source PHP CMS&#xa;marketing site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="325" y="440" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Web ACL -->
        <mxCell id="acl" value="Web ACL (pushed by FMS · CLOUDFRONT scope · us-east-1 · default Allow) — evaluated top to bottom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4f4;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="580" y="90" width="580" height="700" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="1 · FMS pre-process · custom groups&#xa;PHP probe block · allow-by-IP-set (partner/internal) · NAT egress allow (misnamed) · security-plugin allow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="600" y="130" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;2 · AWSManagedRulesBotControlRuleSet&lt;/b&gt; · COMMON · default version (not pinned) · no scope-down&lt;br&gt;SignalNonBrowserUserAgent → &lt;b&gt;Count&lt;/b&gt; (adds signal:non_browser_user_agent; skips verified bots)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;CategoryAI → Block&lt;/b&gt; — verified and unverified AI bots alike&lt;/font&gt;&lt;br&gt;availableLabels: no bot:name:* for the vendor in question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="600" y="195" width="540" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="3 · Geo-block (one country)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="600" y="300" width="540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="4 · Request body-size groups (x4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="600" y="345" width="540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="5 · AWSManagedRulesAmazonIpReputationList" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="600" y="390" width="540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="6 · AWSManagedRulesCommonRuleSet (4 rules in Count)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="600" y="435" width="540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="7 · CMS-specific managed group · SQLi · PHP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="600" y="480" width="540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r8" value="&lt;b&gt;8 · FMS post-process · &amp;lt;allow_seo_crawler_ua&amp;gt;&lt;/b&gt; (12 WCU, last group)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;action BLOCK, despite the name&lt;/b&gt;&lt;/font&gt;&lt;br&gt;label signal:non_browser_user_agent&lt;br&gt;AND NOT User-Agent EXACTLY &quot;&amp;lt;seo-crawler-ua-string&amp;gt;&quot; (no transformation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="600" y="540" width="540" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rdef" value="default action → Allow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="600" y="650" width="540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="aclnote" value="Labels added by Count rules travel down the web ACL. A label-based rule can only match labels that an earlier rule actually added." style="text;html=1;fontSize=10;align=left;fontColor=#666666;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="605" y="700" width="530" height="40" as="geometry" />
        </mxCell>

        <!-- Results -->
        <mxCell id="res403B" value="403 · blocker B&#xa;terminatingRuleId: Bot Control group&#xa;terminatingRule: CategoryAI&#xa;labels: bot:category:ai, bot:name:*, bot:verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="1230" y="200" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="res403A" value="403 · blocker A (primary)&#xa;terminatingRuleId: &amp;lt;allow_seo_crawler_ua&amp;gt;&#xa;labels: signal:non_browser_user_agent only&#xa;no bot:category:ai · no bot:verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="1230" y="545" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- Security account -->
        <mxCell id="secAcct" value="&amp;lt;ACCOUNT_SECURITY&amp;gt; · Firewall Manager administrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="580" width="490" height="210" as="geometry" />
        </mxCell>
        <mxCell id="fms" value="FMS policy &amp;lt;fms-web-policy&amp;gt;&#xa;resource type CLOUDFRONT · account include list&#xa;auto-remediation disabled&#xa;owns pre/post-process custom groups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="60" y="620" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="logs" value="S3 bucket aws-waf-logs-*&#xa;WAF full logs&#xa;(Athena)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="300" y="620" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="secnote" value="AWS Organizations · policy pushed to the app account's distributions" style="text;html=1;fontSize=10;align=left;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="60" y="730" width="450" height="20" as="geometry" />
        </mxCell>

        <!-- Evidence -->
        <mxCell id="evidence" value="&lt;b&gt;Evidence&lt;/b&gt;&lt;br&gt;• DescribeManagedRuleGroup (default version): availableLabels has bot:category:ai and several AI bot:name:* labels, none for this vendor&lt;br&gt;• Customer logs filtered by vendor IP ranges: 90–95% terminated by the custom rule, few by CategoryAI&lt;br&gt;• Rule group definition: BLOCK on label AND NOT exact UA&lt;br&gt;• Not confirmed: individual log samples (terminatingRuleId, labels, UA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="1200" y="680" width="460" height="110" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend: red = flow A (unclassified crawler) · orange = flow B (classified AI bot) · green = allowed path · grey = no match, request continues" style="text;html=1;fontSize=10;align=left;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="40" y="820" width="900" height="20" as="geometry" />
        </mxCell>

