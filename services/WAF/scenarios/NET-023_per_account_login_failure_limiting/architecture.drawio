<mxfile host="app.diagrams.net">
  <diagram id="net023" name="NET-023 Request path">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="NET-023 — Per-account login failure limiting (REGIONAL web ACL)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="account" value="&lt;ACCOUNT_APP&gt; — single Region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="70" width="700" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="Client app&lt;br&gt;POST /token&lt;br&gt;grant_type=password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="apigw" value="API Gateway / ALB&lt;br&gt;(TLS terminates here)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="190" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="waf" value="AWS WAF (REGIONAL)&lt;br&gt;1. Rate-based per IP&lt;br&gt;2. ATP request inspection&lt;br&gt;(FORM_ENCODED)&lt;br&gt;&lt;i&gt;no response visibility&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="330" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="lambda" value="Lambda (OAuth token endpoint)&lt;br&gt;&lt;b&gt;per-account failure counter&lt;/b&gt;&lt;br&gt;429 + Retry-After when fails ≥ 5 / min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="180" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ddb" value="DynamoDB&lt;br&gt;pk = sha256(username)#minute&lt;br&gt;ADD fails, TTL 120 s" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="330" width="160" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="idp" value="External IdP&lt;br&gt;(only place where&lt;br&gt;&quot;login failed&quot; is known)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="190" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="1. request" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="client" target="apigw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="2. verdict? (request only)" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="apigw" target="waf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="3. forward if ALLOW" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="apigw" target="lambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="4. check / increment" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="lambda" target="ddb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="5. validate credentials (skipped when blocked)" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="lambda" target="idp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Response (200 / 400 invalid_grant / 429) returns through API Gateway or the ALB to the client.&lt;br&gt;It is never sent back to a REGIONAL web ACL. ATP response inspection exists only for CloudFront." style="text;html=1;fontSize=11;align=left;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="220" y="510" width="760" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
