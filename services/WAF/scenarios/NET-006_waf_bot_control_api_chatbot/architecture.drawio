          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="300" y="170" /><mxPoint x="300" y="315" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cf-apigw" value="Origin request" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;fontSize=9;" parent="1" source="cloudfront" target="apigw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apigw-lambda" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;" parent="1" source="apigw" target="lambda" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
