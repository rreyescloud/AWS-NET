          <mxGeometry x="720" y="280" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Regional WAF -->
        <mxCell id="regional-waf" value="Regional WAF&#xa;(REGIONAL scope)&#xa;&#xa;Ensures API GW only&#xa;accepts traffic from CF&#xa;(Origin header check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;verticalAlign=top;" parent="1" vertex="1">
