        </mxCell>

        <!-- WAF evaluation arrows -->
        <mxCell id="waf-eval-global" value="evaluates" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=1;dashed=1;fontSize=9;" parent="1" source="global-waf" target="cloudfront" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="waf-eval-regional" value="evaluates" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=1;dashed=1;fontSize=9;" parent="1" source="regional-waf" target="apigw" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Problem Box -->
        <mxCell id="problem" value="THE PROBLEM:&#xa;&#xa;Bot Control (Targeted + ML) emits&#xa;CAPTCHA / Challenge responses.&#xa;&#xa;These require a BROWSER to execute&#xa;JavaScript. But this is a REST API —&#xa;the frontend receives the Challenge&#xa;as an error response (not a rendered page).&#xa;&#xa;Challenge ≠ compatible with API calls." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="100" y="480" width="320" height="170" as="geometry" />
        </mxCell>

        <!-- Solution Box -->
        <mxCell id="solution" value="SOLUTIONS:&#xa;&#xa;1. Bot Control in COUNT mode + label-based&#xa;   custom rules (block instead of challenge)&#xa;&#xa;2. AWS WAF JS SDK in frontend → acquires&#xa;   token silently → sends in API header →&#xa;   Bot Control validates token (no challenge)&#xa;&#xa;3. Skip Bot Control entirely → use custom&#xa;   rules: rate limit, geo-restrict, UA filter,&#xa;   request body size limits" style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="480" y="480" width="340" height="170" as="geometry" />
        </mxCell>

        <!-- How Challenge works -->
        <mxCell id="challenge-explain" value="HOW CHALLENGE WORKS:&#xa;&#xa;1. Request arrives at WAF&#xa;2. WAF returns 202 + JavaScript challenge&#xa;3. Browser executes JS (proves it's human)&#xa;4. Browser gets a TOKEN (cookie: aws-waf-token)&#xa;5. Browser re-sends request with token&#xa;6. WAF validates token → allows request&#xa;&#xa;For APIs: Step 3 fails because there's no&#xa;browser to execute the JS. The API client&#xa;receives a 202 HTML response = 'error'." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="880" y="480" width="320" height="170" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
