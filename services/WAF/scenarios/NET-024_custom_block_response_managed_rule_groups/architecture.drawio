<mxfile host="app.diagrams.net">
  <diagram id="net024" name="NET-024 Block response sources">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="NET-024 — Where the block response comes from (CloudFront + WAF + Firewall Manager)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="viewer" value="Viewer&lt;br&gt;portal.example.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cf" value="CloudFront distribution&lt;br&gt;&lt;b&gt;custom error response 403&lt;/b&gt;&lt;br&gt;(precedence 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="110" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="origin" value="Origin&lt;br&gt;/errors/403.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="250" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="acl" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="560" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="acltitle" value="Web ACL (CLOUDFRONT) — managed by Firewall Manager, RETROFIT_EXISTING" style="text;html=1;fontSize=11;fontStyle=1;align=left;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="510" y="85" width="540" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="pre1" value="preProcess · AWS managed rule groups&lt;br&gt;today: Block → &lt;b&gt;default 403&lt;/b&gt; (no custom response)&lt;br&gt;fix B: OverrideAction Count → labels only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="115" width="500" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pre2" value="preProcess (last) · fix B: BlockManagedMatches&lt;br&gt;label match → Block + &lt;b&gt;custom response&lt;/b&gt; (precedence 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="190" width="500" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="own" value="Account's own rules (retrofit) · rate-based / custom groups with custom response · Allow rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="255" width="500" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="post" value="postProcess · ✗ wrong place for the label block: own Allow rules end evaluation first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="320" width="500" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="def" value="Default action · Allow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="380" width="500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="request" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="viewer" target="cf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="verdict?" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="cf" target="pre1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="fetch error page (fix A)" style="endArrow=classic;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="cf" target="origin">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Precedence for a blocked request: 1. WAF custom response → 2. CloudFront custom error response (403) → 3. WAF default 403.&lt;br&gt;Fix A = CloudFront 403 page (no WAF change). Fix B = managed groups in Count + label-blocking group at the end of preProcess." style="text;html=1;fontSize=11;align=left;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="1020" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
