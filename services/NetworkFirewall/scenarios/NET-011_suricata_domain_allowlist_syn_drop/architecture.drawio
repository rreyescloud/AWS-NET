<mxfile host="drawio-plugin" modified="2026-09-23T12:00:00.000Z" agent="Mozilla/5.0" version="22.1.22" etag="NET011-syn-drop" type="embed">
  <diagram name="NET-011: Catch-all drop kills the SYN before SNI exists" id="net011-syn-drop">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="NET-011: Why a correct TLS SNI allowlist never matches" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="400" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The allowlist rule is right. It is never reached, because the catch-all drop fires one packet earlier." style="text;html=1;fontSize=11;align=center;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="400" y="50" width="900" height="20" as="geometry" />
        </mxCell>

        <!-- ================= LEFT: broken ================= -->
        <mxCell id="broken-box" value="BROKEN — drop evaluated against the SYN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;verticalAlign=top;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="100" width="760" height="620" as="geometry" />
        </mxCell>

        <mxCell id="b-client" value="Workload&#xa;10.212.2.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="100" y="150" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b-fw" value="Network Firewall&#xa;stateful engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="330" y="150" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b-dest" value="allowed-domain.example&#xa;443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="600" y="150" width="160" height="55" as="geometry" />
        </mxCell>

        <!-- Rule order, broken -->
        <mxCell id="b-rules" value="Rule group, evaluation order&#xa;&#xa;1.  pass tls ... tls.sni; content:&quot;allowed-domain.example&quot;&#xa;2.  drop ip any any -&gt; any any    ← catch-all" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="100" y="240" width="660" height="95" as="geometry" />
        </mxCell>

        <!-- Packet walk -->
        <mxCell id="b-step1" value="Packet 1 — TCP SYN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="100" y="370" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-step1-detail" value="No TLS yet. No ClientHello, so tls.sni does not exist.&#xa;Rule 1 cannot match — there is nothing to match on.&#xa;Rule 2 matches everything → DROP." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="300" y="365" width="460" height="55" as="geometry" />
        </mxCell>

        <mxCell id="b-step2" value="Packet 2 — TLS ClientHello" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=1;dashed=1;fontColor=#999999;" parent="1" vertex="1">
          <mxGeometry x="100" y="440" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-step2-detail" value="Never sent. The handshake died at the SYN, so the packet&#xa;that would have carried the SNI never leaves the client." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#999999;" parent="1" vertex="1">
          <mxGeometry x="300" y="437" width="460" height="45" as="geometry" />
        </mxCell>

        <!-- The diagnostic -->
        <mxCell id="b-logs" value="What the alert log shows&#xa;&#xa;  ✓  drop  10.212.2.x:49152 -&gt; 203.0.113.10:443   (catch-all)&#xa;  ✗  no  pass  entry for the allowlist rule — ever&#xa;  ✗  no  tls.sni  field on any event" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4f4;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="100" y="510" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-insight" value="Diagnose by what is ABSENT, not what is present.&#xa;A rule that never appears in the log was never evaluated." style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="100" y="630" width="660" height="50" as="geometry" />
        </mxCell>

        <!-- arrows broken -->
        <mxCell id="b-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;" parent="1" source="b-client" target="b-fw" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e2" value="SYN dropped" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=3;endArrow=cross;dashed=1;fontSize=10;fontColor=#b85450;" parent="1" source="b-fw" target="b-dest" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ================= RIGHT: fixed ================= -->
        <mxCell id="fix-box" value="FIXED — let the handshake reach the point where SNI exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=top;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="860" y="100" width="780" height="620" as="geometry" />
        </mxCell>

        <mxCell id="f-client" value="Workload&#xa;10.212.2.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="900" y="150" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-fw" value="Network Firewall&#xa;stateful engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1140" y="150" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-dest" value="allowed-domain.example&#xa;443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="1410" y="150" width="170" height="55" as="geometry" />
        </mxCell>

        <mxCell id="f-rules" value="Rule group, evaluation order&#xa;&#xa;1.  pass tcp any any -&gt; any 443 (flow:not_established;)   ← let the SYN through&#xa;2.  pass tls ... tls.sni; content:&quot;allowed-domain.example&quot;&#xa;3.  drop tls any any -&gt; any any    ← catch-all scoped to TLS, not to IP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="900" y="240" width="680" height="110" as="geometry" />
        </mxCell>

        <mxCell id="f-step1" value="Packet 1 — TCP SYN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="380" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f-step1-detail" value="Rule 1 passes it. Handshake is allowed to begin." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1100" y="385" width="480" height="30" as="geometry" />
        </mxCell>

        <mxCell id="f-step2" value="Packet 2 — ClientHello" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="440" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f-step2-detail" value="Now tls.sni exists. Rule 2 evaluates it and matches → PASS.&#xa;A ClientHello for any other name falls through to rule 3 → DROP." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1100" y="437" width="480" height="45" as="geometry" />
        </mxCell>

        <mxCell id="f-logs" value="What the alert log shows now&#xa;&#xa;  ✓  pass  ... tls.sni=allowed-domain.example&#xa;  ✓  drop  ... tls.sni=blocked-domain.example&#xa;  →  both rules appear, so both are being evaluated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4fff4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="900" y="510" width="680" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f-insight" value="The catch-all must be scoped to the protocol you are filtering.&#xa;A catch-all on `ip` outranks the handshake your rule depends on." style="text;html=1;fontSize=12;fontStyle=1;align=center;fontColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="900" y="630" width="680" height="50" as="geometry" />
        </mxCell>

        <mxCell id="f-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;" parent="1" source="f-client" target="f-fw" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-e2" value="handshake completes" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=3;endArrow=block;fontSize=10;fontColor=#82b366;" parent="1" source="f-fw" target="f-dest" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Footer -->
        <mxCell id="footer" value="Takeaway: an allowlist keyed on an application-layer field is only reachable if the transport-layer handshake that carries that field is permitted first." style="text;html=1;fontSize=12;fontStyle=2;align=center;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="200" y="750" width="1300" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
