  <diagram id="lab-architecture" name="Lab Architecture - NF TLS Inspection">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;NET-004 Lab — Network Firewall TLS Inspection (Inbound)&lt;/b&gt;&lt;br&gt;Region: eu-west-1 | Profile: lab" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="370" y="20" width="560" height="50" as="geometry" />
        </mxCell>
        <!-- Internet -->
        <mxCell id="internet" value="☁️ Internet&lt;br&gt;(Cliente externo)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="80" width="160" height="80" as="geometry" />
        </mxCell>
        <!-- IGW -->
        <mxCell id="igw" value="&lt;b&gt;IGW&lt;/b&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1">
          <mxGeometry x="625" y="190" width="50" height="50" as="geometry" />
        </mxCell>
        <!-- Arrow Internet to IGW -->
        <mxCell id="arr_inet_igw" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="internet" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- VPC -->
        <mxCell id="vpc" value="&lt;b&gt;VPC: net004-lab-vpc&lt;/b&gt;&lt;br&gt;10.0.0.0/16" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#248814;fillColor=#E9F3E6;verticalAlign=top;align=left;spacingLeft=30;fontColor=#AAB7B8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="200" y="260" width="900" height="680" as="geometry" />
        </mxCell>
        <!-- Arrow IGW to VPC -->
        <mxCell id="arr_igw_vpc" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="igw" target="vpc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Firewall Subnet -->
        <mxCell id="fw_subnet" value="&lt;b&gt;Firewall Subnet&lt;/b&gt;&lt;br&gt;10.0.1.0/28&lt;br&gt;(net004-fw-subnet)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="310" width="560" height="170" as="geometry" />
        </mxCell>
        <!-- Network Firewall -->
        <mxCell id="nf" value="&lt;b&gt;AWS Network Firewall&lt;/b&gt;&lt;br&gt;net004-lab-firewall&lt;br&gt;&lt;br&gt;TLS Inspection Config:&lt;br&gt;Inbound (port 443)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=middle;verticalAlign=middle;align=left;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.network_firewall;labelPosition=right;" vertex="1" parent="1">
          <mxGeometry x="600" y="365" width="48" height="48" as="geometry" />
        </mxCell>
        <!-- ACM Certificate callout -->
        <mxCell id="acm_cert" value="&lt;b&gt;ACM Certificate&lt;/b&gt;&lt;br&gt;(Imported — test cross-signed)&lt;br&gt;&lt;br&gt;🔑 Cert + Chain + Private Key&lt;br&gt;&lt;font color=&quot;#CC0000&quot;&gt;❌ Cross-signed root → NF rejects&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;✅ Direct root → NF accepts&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="750" y="330" width="200" height="110" as="geometry" />
        </mxCell>
        <!-- Arrow NF to ACM -->
        <mxCell id="arr_nf_acm" style="endArrow=block;endFill=1;strokeColor=#d6b656;dashed=1;" edge="1" parent="1" source="nf" target="acm_cert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Public Subnet (ALB) -->
        <mxCell id="pub_subnet" value="&lt;b&gt;Public Subnet&lt;/b&gt;&lt;br&gt;10.0.2.0/24&lt;br&gt;(net004-public-subnet)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="530" width="560" height="160" as="geometry" />
        </mxCell>
        <!-- ALB -->
        <mxCell id="alb" value="&lt;b&gt;ALB&lt;/b&gt;&lt;br&gt;net004-lab-alb&lt;br&gt;HTTPS:443" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=middle;verticalAlign=middle;align=left;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;labelPosition=right;" vertex="1" parent="1">
          <mxGeometry x="600" y="585" width="48" height="48" as="geometry" />
        </mxCell>
        <!-- Arrow NF to ALB -->
        <mxCell id="arr_nf_alb" value="Inspected traffic" style="endArrow=block;endFill=1;strokeColor=#009900;strokeWidth=2;fontColor=#009900;fontSize=10;" edge="1" parent="1" source="nf" target="alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Private Subnet -->
        <mxCell id="priv_subnet" value="&lt;b&gt;Private Subnet&lt;/b&gt;&lt;br&gt;10.0.3.0/24&lt;br&gt;(net004-private-subnet)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#147EBA;fillColor=#E6F2F8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="740" width="560" height="160" as="geometry" />
        </mxCell>
        <!-- EC2 Target -->
        <mxCell id="ec2" value="&lt;b&gt;EC2 Instance&lt;/b&gt;&lt;br&gt;net004-web-server&lt;br&gt;(nginx / httpd)&lt;br&gt;Port 80" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=middle;verticalAlign=middle;align=left;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;labelPosition=right;" vertex="1" parent="1">
          <mxGeometry x="600" y="795" width="48" height="48" as="geometry" />
        </mxCell>
        <!-- Arrow ALB to EC2 -->
        <mxCell id="arr_alb_ec2" value="HTTP:80" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="alb" target="ec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Route Tables -->
        <mxCell id="rt_igw" value="&lt;b&gt;RT: IGW Edge&lt;/b&gt;&lt;br&gt;10.0.2.0/24 → fw-endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#999999;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="230" y="330" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rt_pub" value="&lt;b&gt;RT: Public&lt;/b&gt;&lt;br&gt;0.0.0.0/0 → IGW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#999999;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="230" y="555" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rt_priv" value="&lt;b&gt;RT: Private&lt;/b&gt;&lt;br&gt;0.0.0.0/0 → NAT (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#999999;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="230" y="770" width="120" height="50" as="geometry" />
        </mxCell>
        <!-- Flow description -->
        <mxCell id="flow" value="&lt;b&gt;Flujo Inbound:&lt;/b&gt;&lt;br&gt;1. Cliente → IGW&lt;br&gt;2. IGW edge RT → NF endpoint (fw subnet)&lt;br&gt;3. NF TLS Inspection (descifra, inspecciona, re-cifra)&lt;br&gt;4. NF → ALB (public subnet)&lt;br&gt;5. ALB → EC2 (private subnet, HTTP:80)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#E6F3FF;strokeColor=#6c8ebf;align=left;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="430" width="310" height="110" as="geometry" />
        </mxCell>
        <!-- Test scenarios -->
        <mxCell id="tests" value="&lt;b&gt;Escenarios a probar:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1️⃣ Import cert con cross-signed root (Let's Encrypt)&lt;br&gt;   → Esperamos: ❌ CreateTLSInspectionConfig falla&lt;br&gt;&lt;br&gt;2️⃣ Import cert con root directo (self-signed CA)&lt;br&gt;   → Esperamos: ✅ TLS Inspection funciona&lt;br&gt;&lt;br&gt;3️⃣ ACM AMAZON_ISSUED cert (native, mismo account)&lt;br&gt;   → Esperamos: ✅ TLS Inspection funciona" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;align=left;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="980" y="530" width="340" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="traffic-flow" name="Traffic Flow Detail">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="tf_title" value="&lt;b&gt;Routing del tráfico inbound con Network Firewall&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="430" height="30" as="geometry" />
        </mxCell>
        <!-- Steps -->
        <mxCell id="step1" value="&lt;b&gt;① Cliente&lt;/b&gt;&lt;br&gt;HTTPS request&lt;br&gt;dst: EIP/ALB DNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="&lt;b&gt;② IGW&lt;/b&gt;&lt;br&gt;Edge RT redirige&lt;br&gt;a NF endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="100" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="&lt;b&gt;③ NF Endpoint&lt;/b&gt;&lt;br&gt;TLS Termination&lt;br&gt;Suricata Inspect&lt;br&gt;Re-encrypt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#d79b00;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="&lt;b&gt;④ ALB&lt;/b&gt;&lt;br&gt;TLS termination&lt;br&gt;(again)&lt;br&gt;→ target group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6D0F7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="100" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="&lt;b&gt;⑤ EC2&lt;/b&gt;&lt;br&gt;HTTP:80&lt;br&gt;nginx response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="850" y="100" width="130" height="60" as="geometry" />
        </mxCell>
        <!-- Arrows -->
        <mxCell id="a12" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a23" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a34" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a45" style="endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Encryption status bar -->
        <mxCell id="enc_bar1" value="🔒 HTTPS (cifrado con cert original)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#dae8fc;fontSize=10;fontColor=#0066CC;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="enc_bar2" value="🔓 Texto plano (NF inspecciona)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#f8cecc;fontSize=10;fontColor=#CC0000;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="200" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="enc_bar3" value="🔒 Re-cifrado (nueva sesión TLS)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#d5e8d4;fontSize=10;fontColor=#009900;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="200" width="230" height="30" as="geometry" />
        </mxCell>
        <!-- Route table detail -->
        <mxCell id="rt_detail" value="&lt;b&gt;Route Tables necesarias:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;IGW Edge Route Table:&lt;/b&gt;&lt;br&gt;  10.0.2.0/24 → vpce-xxx (NF endpoint)&lt;br&gt;&lt;br&gt;&lt;b&gt;Firewall Subnet RT:&lt;/b&gt;&lt;br&gt;  0.0.0.0/0 → igw-xxx&lt;br&gt;&lt;br&gt;&lt;b&gt;Public Subnet RT:&lt;/b&gt;&lt;br&gt;  0.0.0.0/0 → igw-xxx&lt;br&gt;&lt;br&gt;&lt;b&gt;Private Subnet RT:&lt;/b&gt;&lt;br&gt;  0.0.0.0/0 → nat-xxx (si necesita salida)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FFF2CC;strokeColor=#d6b656;align=left;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="250" y="280" width="280" height="200" as="geometry" />
        </mxCell>
        <!-- Key insight -->
        <mxCell id="insight" value="&lt;b&gt;Clave del routing:&lt;/b&gt;&lt;br&gt;El IGW Edge Route Table es lo que fuerza el tráfico&lt;br&gt;a pasar por NF antes de llegar al ALB.&lt;br&gt;Sin esta RT, el tráfico va directo IGW → ALB." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#E6F3FF;strokeColor=#6c8ebf;align=left;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="280" width="280" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
