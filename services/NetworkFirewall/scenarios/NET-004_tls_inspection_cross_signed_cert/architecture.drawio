        </mxCell>
        <mxCell id="error-box" value="ERROR:&#xa;&#xa;1st attempt: Chain invalid&#xa;2nd attempt: Cross-signed root&#xa;&#xa;NF cannot validate the root CA&#xa;of the imported certificate" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="880" y="330" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="solutions" value="SOLUTIONS:&#xa;&#xa;A. Issue ACM public cert directly&#xa;   in Account B (no cross-account)&#xa;&#xa;B. ACM Private CA + RAM sharing&#xa;   (central CA, local issuance)&#xa;&#xa;C. ACM Private CA + export&#xa;   (export with key, import in B)&#xa;&#xa;D. External CA (non-cross-signed)&#xa;   DigiCert, GlobalSign, etc." style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
