        <mxCell id="cert-type" value="Certificate Type: ?&#xa;AMAZON_ISSUED or IMPORTED?&#xa;&#xa;If AMAZON_ISSUED:&#xa;  → Private key NOT exportable&#xa;  → Cannot use cross-account&#xa;&#xa;If IMPORTED (Let&#39;s Encrypt):&#xa;  → Has cross-signed root&#xa;  → NF rejects it" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="110" y="200" width="230" height="140" as="geometry" />
