            <mxPoint x="120" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ke4" value="Key Exchange → Session keys generadas" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#0066CC;fontSize=10;fontColor=#0066CC;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="380" as="sourcePoint" />
            <mxPoint x="630" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="enc4_1" value="═══ Sesión TLS #1 establecida (Cliente ↔ NF) ═══" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#CC6600;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="220" y="410" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="http_req" value="&lt;b&gt;HTTP Request (cifrado)&lt;/b&gt;&lt;br&gt;GET /api/trades HTTP/1.1" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#0066CC;fontSize=10;fontColor=#0066CC;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="460" as="sourcePoint" />
            <mxPoint x="630" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="inspect" value="🔍 NF DESCIFRA E INSPECCIONA&lt;br&gt;• Suricata rules&lt;br&gt;• Detecta malware, injection, C2&lt;br&gt;• Si OK → re-cifra y reenvía" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="560" y="490" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sess2" value="SESIÓN TLS #2" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFE6CC;fontSize=11;fontColor=#d79b00;fontStyle=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="850" y="570" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tcp2" value="TCP Handshake" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#999999;fontSize=9;fontColor=#999999;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="610" as="sourcePoint" />
            <mxPoint x="1170" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tls2" value="TLS Handshake (NF como cliente → Servidor real)" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#CC6600;fontSize=10;fontColor=#CC6600;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="660" as="sourcePoint" />
            <mxPoint x="1170" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fwd" value="&lt;b&gt;HTTP Request (re-cifrado)&lt;/b&gt;&lt;br&gt;GET /api/trades HTTP/1.1" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#CC6600;fontSize=10;fontColor=#CC6600;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="720" as="sourcePoint" />
            <mxPoint x="1170" y="720" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="resp" value="&lt;b&gt;HTTP Response (cifrado)&lt;/b&gt;&lt;br&gt;200 OK {trades:[...]}" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#009900;fontSize=10;fontColor=#009900;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="780" as="sourcePoint" />
            <mxPoint x="120" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pk_note" value="&lt;b&gt;¿Por qué NF necesita la private key?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Porque en la Sesión #1 actúa como el servidor real.&lt;br&gt;El cliente hace key exchange usando la public key del cert.&lt;br&gt;Sin la private key, NF no puede descifrar el pre-master secret&lt;br&gt;→ no puede generar session keys → no puede descifrar tráfico.&lt;br&gt;&lt;br&gt;&lt;b&gt;NET-004:&lt;/b&gt; El cert importado tiene root cross-signed → NF lo&lt;br&gt;rechaza al crear TLSInspectionConfiguration (ni llega a usarlo)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;align=left;fontSize=10;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="30" y="600" width="420" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
