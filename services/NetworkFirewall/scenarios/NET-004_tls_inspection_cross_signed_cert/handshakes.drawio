            <mxPoint x="1170" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sess1" value="SESIÓN TLS #1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFE6CC;fontSize=11;fontColor=#d79b00;fontStyle=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="290" y="170" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tcp1" value="TCP Handshake (SYN/SYN-ACK/ACK)" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#999999;fontSize=9;fontColor=#999999;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="210" as="sourcePoint" />
            <mxPoint x="630" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ch4" value="&lt;b&gt;ClientHello&lt;/b&gt; (SNI: api.trading.example.com)" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#0066CC;fontSize=10;fontColor=#0066CC;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="260" as="sourcePoint" />
            <mxPoint x="630" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nf_cert" value="NF presenta el certificado&lt;br&gt;(usa la PRIVATE KEY configurada)" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.2;base=15;fillColor=#FFE6CC;strokeColor=#d79b00;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="650" y="250" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sh4" value="&lt;b&gt;ServerHello + Certificate&lt;/b&gt; (NF actúa COMO el servidor)" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#CC6600;fontSize=10;fontColor=#CC6600;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
