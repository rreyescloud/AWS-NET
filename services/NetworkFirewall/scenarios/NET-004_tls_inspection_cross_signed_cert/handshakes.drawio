        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Servidor&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="780" y="90" width="120" height="40" as="geometry" />
        </mxCell>
