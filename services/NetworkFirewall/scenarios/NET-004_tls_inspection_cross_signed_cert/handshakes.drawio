            <mxPoint x="840" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="enc13_traffic" value="" style="endArrow=none;html=1;strokeColor=#00CC00;strokeWidth=4;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="610" as="sourcePoint" />
            <mxPoint x="840" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="enc13_traf_label" value="🔒 Tráfico de aplicación cifrado" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#d5e8d4;fontSize=11;fontColor=#009900;fontStyle=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="620" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="comp13" value="&lt;b&gt;vs TLS 1.2:&lt;/b&gt;&lt;br&gt;• Solo 1 round trip (vs 2)&lt;br&gt;• Certificado cifrado (vs plano)&lt;br&gt;• Forward secrecy obligatorio&lt;br&gt;• Cipher suites legacy eliminados" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FFF2CC;strokeColor=#d6b656;align=left;fontSize=10;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="30" y="530" width="170" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-tls-inspection" name="4. NF TLS Inspection (MITM)">
