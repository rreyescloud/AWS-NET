            <mxPoint x="630" y="150" as="sourcePoint" />
            <mxPoint x="630" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Servidor&lt;/b&gt;&lt;br&gt;(ALB → ECS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1100" y="100" width="140" height="50" as="geometry" />
