          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="130" as="sourcePoint" />
            <mxPoint x="840" y="850" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="phase1" value="EN TEXTO PLANO" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#CC0000;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="30" y="150" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ch" value="&lt;b&gt;ClientHello&lt;/b&gt;&lt;br&gt;• SNI: api.example.com&lt;br&gt;• Cipher suites [AES-GCM, ChaCha20...]&lt;br&gt;• Random number (client)&lt;br&gt;• TLS version: 1.2" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#0066CC;fontSize=10;fontColor=#0066CC;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="180" as="sourcePoint" />
            <mxPoint x="840" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sni_call" value="⚠️ SNI visible sin cifrar&lt;br&gt;NF puede filtrar por dominio aquí" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;base=15;fillColor=#FFF2CC;strokeColor=#d6b656;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="420" y="130" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sh" value="&lt;b&gt;ServerHello&lt;/b&gt;&lt;br&gt;• Cipher suite elegido: TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384&lt;br&gt;• Random number (server)" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#009900;fontSize=10;fontColor=#009900;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="270" as="sourcePoint" />
            <mxPoint x="210" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cert" value="&lt;b&gt;Certificate&lt;/b&gt;&lt;br&gt;• Leaf cert (servidor)&lt;br&gt;• Intermediate CA&lt;br&gt;• Root CA (o cross-signed root ← PROBLEMA NET-004)" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#009900;fontSize=10;fontColor=#009900;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="350" as="sourcePoint" />
            <mxPoint x="210" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cert_call" value="🔑 Aquí el cliente valida la cadena de confianza.&lt;br&gt;NF hace lo mismo al crear TLSInspectionConfig.&lt;br&gt;Si el root es cross-signed → ❌ RECHAZADO" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;base=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="370" y="365" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="shd" value="&lt;b&gt;ServerHelloDone&lt;/b&gt;" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#009900;fontSize=10;fontColor=#009900;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="440" as="sourcePoint" />
            <mxPoint x="210" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cke" value="&lt;b&gt;ClientKeyExchange&lt;/b&gt;&lt;br&gt;• Pre-master secret (cifrado con public key del cert)" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#0066CC;fontSize=10;fontColor=#0066CC;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="520" as="sourcePoint" />
            <mxPoint x="840" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="phase2" value="CIFRADO DESDE AQUÍ ↓" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#009900;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="30" y="570" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="enc_line" value="" style="endArrow=none;html=1;strokeColor=#00CC00;strokeWidth=2;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="590" as="sourcePoint" />
            <mxPoint x="920" y="590" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ccs1" value="&lt;b&gt;ChangeCipherSpec + Finished&lt;/b&gt;" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#0066CC;fontSize=10;fontColor=#0066CC;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="630" as="sourcePoint" />
            <mxPoint x="840" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ccs2" value="&lt;b&gt;ChangeCipherSpec + Finished&lt;/b&gt;" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#009900;fontSize=10;fontColor=#009900;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="700" as="sourcePoint" />
            <mxPoint x="210" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="enc_traffic" value="" style="endArrow=none;html=1;strokeColor=#00CC00;strokeWidth=4;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="770" as="sourcePoint" />
            <mxPoint x="840" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="enc_label" value="🔒 Tráfico de aplicación cifrado (HTTP requests/responses)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#d5e8d4;fontSize=11;fontColor=#009900;fontStyle=1;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="330" y="780" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="key_note" value="&lt;b&gt;Derivación de claves:&lt;/b&gt;&lt;br&gt;Master Secret = PRF(pre-master, client_random, server_random)&lt;br&gt;→ Se generan claves simétricas para cifrar/descifrar tráfico" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#E6E6E6;strokeColor=#999999;align=left;fontSize=10;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="350" y="540" width="380" height="50" as="geometry" />
        </mxCell>
