        </mxCell>
        <mxCell id="cert13_call" value="En TLS 1.3 el certificado va cifrado.&lt;br&gt;Un observador pasivo NO puede ver qué cert usa el servidor.&lt;br&gt;(Mejora de privacidad vs TLS 1.2)" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;base=15;fillColor=#E6F3FF;strokeColor=#6c8ebf;fontSize=10;align=center;" parent="1" vertex="1">
