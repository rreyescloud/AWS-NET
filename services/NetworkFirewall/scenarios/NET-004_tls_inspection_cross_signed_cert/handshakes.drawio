        </mxCell>
        <mxCell id="plain13" value="PLANO" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#CC0000;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="155" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ch13" value="&lt;b&gt;ClientHello&lt;/b&gt;&lt;br&gt;• SNI: api.example.com (plano)&lt;br&gt;• Supported versions: [1.3, 1.2]&lt;br&gt;• Key Share: x25519 public key ← ¡adelanta la negociación!&lt;br&gt;• Cipher suites" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#0066CC;fontSize=10;fontColor=#0066CC;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="180" as="sourcePoint" />
            <mxPoint x="840" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="enc13_line" value="" style="endArrow=none;html=1;strokeColor=#00CC00;strokeWidth=2;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="270" as="sourcePoint" />
            <mxPoint x="920" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="enc13_label" value="CIFRADO DESDE AQUÍ ↓" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#009900;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="260" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sh13" value="&lt;b&gt;ServerHello&lt;/b&gt; + Key Share&lt;br&gt;• Server&#39;s x25519 public key" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#009900;fontSize=10;fontColor=#009900;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="320" as="sourcePoint" />
            <mxPoint x="210" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cert13" value="&lt;b&gt;Certificate&lt;/b&gt; (CIFRADO — no visible en la red)&lt;br&gt;• Leaf + Intermediate + Root" style="html=1;align=center;verticalAlign=middle;endArrow=block;endFill=1;strokeColor=#009900;fontSize=10;fontColor=#009900;dashed=1;" parent="1" edge="1">
