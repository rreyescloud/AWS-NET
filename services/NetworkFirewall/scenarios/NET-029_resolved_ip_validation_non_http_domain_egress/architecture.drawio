<mxfile host="drawio-plugin" modified="2026-11-10T12:00:00.000Z" agent="Mozilla/5.0" version="22.1.22" etag="NET029-riv" type="embed">
  <diagram name="NET-029: Resolved IP validation" id="net029-riv">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="NET-029: Network Firewall validates that the destination IP came from the VPC Route 53 Resolver" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="200" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Policy level: was this IP resolved for any domain? · Rule level: was it resolved for THIS domain? · Works for any protocol (SSH, SFTP, TLS, TCP)" style="text;html=1;fontSize=11;align=center;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="200" y="50" width="1200" height="20" as="geometry" />
        </mxCell>

        <!-- Spoke VPC -->
