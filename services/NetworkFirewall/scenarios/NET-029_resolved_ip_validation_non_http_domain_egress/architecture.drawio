          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="830" y="460" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Key settings&lt;/b&gt;: DNSFirewallRuleGroupId must be associated with every source VPC · SourceIPRanges omitted = firewall VPC CIDR (set spoke CIDRs explicitly in TGW models) · [] = validate nothing · BypassDestinationValidationIPRanges for fixed-IP destinations · DNSExpiryExceptionPolicy CONTINUE for long sessions · enabling or changing the rule group ID may restart the stateful engine" style="text;html=1;whiteSpace=wrap;fontSize=11;fillColor=#f9f9f9;strokeColor=#cccccc;rounded=1;spacing=8;" parent="1" vertex="1">
