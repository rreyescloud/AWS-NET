        </mxCell>

        <!-- TGW -->
        <mxCell id="tgw" value="Transit Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="450" y="330" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- Inspection VPC -->
        <mxCell id="insp" value="Inspection VPC 10.0.0.0/16 (&lt;ACCOUNT_NETWORK&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="630" y="110" width="520" height="400" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="Resolved IP cache&lt;br&gt;198.51.100.20 ↔ sftp.partner.example.com&lt;br&gt;&lt;i&gt;kept longer than TTL&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
