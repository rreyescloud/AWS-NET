        <!-- Flow description -->
        <mxCell id="flow-desc" value="TRAFFIC FLOW:&#xa;&#xa;① Aurora (10.0.2.165:3306) → DMS (10.0.1.17)&#xa;   DMS reads MySQL binlog via CDC&#xa;   Cross-AZ traffic (az1b → az1a)&#xa;&#xa;② DMS (10.0.1.17) → MSK (10.0.1.204:9098)&#xa;   DMS writes events to Kafka topic&#xa;   Same-AZ traffic (both in az1a)&#xa;&#xa;All private, no internet needed.&#xa;Single VPC, single route table." style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
