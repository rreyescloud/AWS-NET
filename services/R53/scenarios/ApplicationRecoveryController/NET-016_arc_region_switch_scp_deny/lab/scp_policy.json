{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRecoveryClusterUnlessKnownNetwork",
      "Effect": "Deny",
      "Action": [
        "route53-recovery-cluster:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "aws:SourceVpce": "vpce-*"
        },
        "NotIpAddress": {
          "aws:SourceIp": [
            "203.0.113.0/24"
          ]
        },
        "Bool": {
          "aws:ViaAWSService": "false"
        },
        "BoolIfExists": {
          "aws:PrincipalIsAWSService": "false"
        }
      }
    }
  ]
}
