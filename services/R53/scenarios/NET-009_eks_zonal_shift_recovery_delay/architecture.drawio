  <diagram name="EKS Zonal Shift Recovery Chain" id="zonal-shift-recovery">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;EKS Zonal Shift — Recovery Chain (Polling-Based)&lt;/b&gt;&#xa;Why recovery takes ~5-24 minutes after shift expiry" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="50" as="geometry" />
        </mxCell>

