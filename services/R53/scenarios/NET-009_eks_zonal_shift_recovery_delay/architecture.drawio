          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="130" as="sourcePoint" />
            <mxPoint x="1500" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tl_label" value="TIME →" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1450" y="110" width="50" height="20" as="geometry" />
        </mxCell>

