        <!-- SLA Box -->
        <mxCell id="sla_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#388E3C;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="155" width="1020" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sla_label" value="✅ Internal SLA: 5 minutes (Stages 1-5)" style="text;html=1;fontSize=10;fontColor=#388E3C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="300" height="20" as="geometry" />
