          <mxGeometry x="1260" y="135" width="50" height="15" as="geometry" />
        </mxCell>

        <!-- Stage 1: PeRC -->
        <mxCell id="s1" value="&lt;b&gt;Stage 1&lt;/b&gt;&#xa;ARC (PeRC)&#xa;&#xa;Shift expira&#xa;internamente&#xa;&#xa;~0s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="170" width="140" height="120" as="geometry" />
        </mxCell>

        <!-- Stage 2: WSS Poller -->
        <mxCell id="s2" value="&lt;b&gt;Stage 2&lt;/b&gt;&#xa;EKS Weight Shift&#xa;Poller&#xa;&#xa;Polls PeRC cada 30s&#xa;Detecta weight = 1.0&#xa;&#xa;⏱️ hasta 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="290" y="170" width="160" height="120" as="geometry" />
        </mxCell>

        <!-- Stage 3: WSS Executor -->
        <mxCell id="s3" value="&lt;b&gt;Stage 3&lt;/b&gt;&#xa;EKS Weight Shift&#xa;Executor&#xa;&#xa;Loop cada 15s&#xa;Escribe config en S3&#xa;&#xa;⏱️ hasta 15s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="500" y="170" width="160" height="120" as="geometry" />
        </mxCell>

        <!-- Stage 4: KCP -->
        <mxCell id="s4" value="&lt;b&gt;Stage 4&lt;/b&gt;&#xa;EKS Control Plane&#xa;(KCP)&#xa;&#xa;Polls S3 config&#xa;Uncordon nodes&#xa;Restore EndpointSlices&#xa;&#xa;⏱️ hasta 150s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="710" y="170" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Stage 5: Karpenter -->
        <mxCell id="s5" value="&lt;b&gt;Stage 5&lt;/b&gt;&#xa;Karpenter&#xa;Controller&#xa;&#xa;Reconcile cada 30s&#xa;GetManagedResource&#xa;Emit: ShiftCleared&#xa;&#xa;⏱️ hasta 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="940" y="170" width="160" height="140" as="geometry" />
        </mxCell>

        <!-- Stage 6: AsyncEtcdIR (the problematic one) -->
        <mxCell id="s6" value="&lt;b&gt;Stage 6 ⚠️&lt;/b&gt;&#xa;AsyncEtcdIR&#xa;Reconciler&#xa;&#xa;Loop cada 10 MIN&#xa;Final reconciliation&#xa;post-shift&#xa;&#xa;⏱️ hasta 600s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;strokeWidth=3;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1150" y="170" width="170" height="140" as="geometry" />
        </mxCell>

