          <mxGeometry x="1140" y="155" width="190" height="170" as="geometry" />
        </mxCell>
        <mxCell id="problem_label" value="❌ +10 min (if Etcd IR triggered)" style="text;html=1;fontSize=10;fontColor=#D32F2F;fontStyle=1;" vertex="1" parent="1">
