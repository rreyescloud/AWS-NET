          <mxGeometry x="520" y="530" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- AZ3 (the shifted one) -->
        <mxCell id="az3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="850" y="490" width="420" height="320" as="geometry" />
        </mxCell>
        <mxCell id="az3_label" value="&lt;b&gt;apse2-az3&lt;/b&gt; ⚠️ SHIFTED AWAY (then recovering)" style="text;html=1;fontSize=11;fontColor=#D32F2F;" vertex="1" parent="1">
          <mxGeometry x="900" y="495" width="320" height="20" as="geometry" />
        </mxCell>

        <!-- During shift -->
        <mxCell id="az3_during" value="&lt;b&gt;During Shift (1 min):&lt;/b&gt;&#xa;&#xa;✗ Nodes: CORDONED&#xa;✗ EndpointSlices: REMOVED&#xa;✗ Scheduling: DISABLED&#xa;✗ Karpenter: won't launch here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#D32F2F;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="870" y="530" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- After expiry (the problem) -->
        <mxCell id="az3_after" value="&lt;b&gt;After Expiry (~24 min):&lt;/b&gt;&#xa;&#xa;⏳ Waiting for WSS Poller (30s)&#xa;⏳ Waiting for Executor (15s)&#xa;⏳ Waiting for KCP S3 poll (150s)&#xa;⏳ Waiting for Karpenter (30s)&#xa;⏳ Waiting for EtcdIR (10 min!)&#xa;&#xa;Finally:&#xa;✅ Nodes: UNCORDONED&#xa;✅ EndpointSlices: RESTORED&#xa;✅ Scheduling: RE-ENABLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="870" y="660" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Arrow showing the delay -->
        <mxCell id="delay_arrow" value="~24 min delay" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#D32F2F;strokeWidth=2;dashed=1;fontSize=10;fontColor=#D32F2F;fontStyle=1;" edge="1" parent="1" source="az3_during" target="az3_after">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ARC Box (external) -->
        <mxCell id="arc_box" value="&lt;b&gt;ARC (PeRC)&lt;/b&gt;&#xa;&#xa;Shift: EXPIRED at 09:44&#xa;(no CloudTrail event)&#xa;(no push to EKS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#283593;strokeWidth=2;fontSize=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1090" y="530" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- Key insight box -->
        <mxCell id="insight" value="&lt;b&gt;Key Insight:&lt;/b&gt; ARC does NOT notify EKS when shift expires.&#xa;EKS must DISCOVER the expiry by polling ARC every 30 seconds.&#xa;This creates a cascade of sequential polling delays across 5-6 components." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=10;align=center;" vertex="1" parent="1">
