        </mxCell>

        <!-- Aurora reader west -->
        <mxCell id="aurora-reader-west" value="Aurora&#xa;Reader" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;size=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="810" width="80" height="70" as="geometry" />
        </mxCell>

        <!-- Connections West -->
        <mxCell id="r53-alb-west" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" source="r53-record-west" target="alb-west" parent="1">
