        <mxCell id="region-west" value="us-west-2 (Steady-State Standby)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="650" y="600" width="450" height="350" as="geometry" />
        </mxCell>

        <!-- ALB West -->
        <mxCell id="alb-west" value="Application&#xa;Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
