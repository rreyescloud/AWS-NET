        <mxCell id="app-aurora-west" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="app-west" target="aurora-west" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== AURORA GLOBAL DATABASE ==================== -->
        <mxCell id="aurora-global" value="Aurora Global Database&#xa;(Async Replication)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=11;fontStyle=1;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="380" y="980" width="480" height="40" as="geometry" />
        </mxCell>

        <!-- Replication arrow -->
        <mxCell id="repl-arrow" value="async replication" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#82b366;fontSize=9;" edge="1" source="aurora-east" target="aurora-west" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="960" />
              <mxPoint x="870" y="960" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== WORKFLOW STEPS (Right side) ==================== -->
        <mxCell id="workflow-title" value="Region Switch Workflow Steps&#xa;(activate us-west-2)" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="1150" y="360" width="250" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ws1" value="Step 1: Failover Aurora Global DB&#xa;to us-west-2&#xa;(RDS Global Cluster Failover)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1150" y="410" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ws2" value="Step 2: Turn Standby RC ON&#xa;(us-west-2 routing control → On)&#xa;→ Health Check Healthy → DNS resolves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1150" y="480" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ws3" value="Step 3: Turn Primary RC OFF&#xa;(us-east-1 routing control → Off)&#xa;→ Health Check Unhealthy → DNS stops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="550" width="250" height="55" as="geometry" />
        </mxCell>

        <!-- Arrows between workflow steps -->
        <mxCell id="ws1-ws2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ws1" target="ws2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ws2-ws3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ws2" target="ws3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Expected final state -->
        <mxCell id="final-state" value="Expected Final State:&#xa;&#xa;• Aurora Writer: us-west-2 ✓&#xa;• RC Standby (us-west-2): ON ✓&#xa;• RC Primary (us-east-1): OFF&#xa;• DNS: resolves to us-west-2 only&#xa;&#xa;Actual State (BUG):&#xa;&#xa;• Aurora Writer: us-west-2 ✓&#xa;• RC Standby (us-west-2): ON ✓&#xa;• RC Primary (us-east-1): ON ⚠️&#xa;• DNS: resolves to BOTH ⚠️" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1150" y="640" width="250" height="210" as="geometry" />
        </mxCell>

        <!-- ==================== FLOW EXPLANATION ==================== -->
        <mxCell id="flow-title" value="How it works (steady state):" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="1150" y="880" width="250" height="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-desc" value="1. RC Primary ON → HC Healthy → DNS PRIMARY record active&#xa;   → Users resolve to ALB us-east-1&#xa;   → App reads/writes Aurora Writer (us-east-1)&#xa;&#xa;2. RC Standby OFF → HC Unhealthy → DNS SECONDARY record inactive&#xa;   → No traffic to us-west-2&#xa;   → Aurora us-west-2 receives async replication only" style="text;html=1;fontSize=10;align=left;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1150" y="905" width="500" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
