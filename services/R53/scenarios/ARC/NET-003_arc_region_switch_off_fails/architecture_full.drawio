        <!-- App West -->
        <mxCell id="app-west" value="Application&#xa;(ECS / EC2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
