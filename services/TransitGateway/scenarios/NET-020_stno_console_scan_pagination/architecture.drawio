        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;TransitGatewayHub stack&lt;/b&gt; (CloudFormation, first deployed 2020 · upgraded to v3.3.28 in 2026 through a change set that pinned the version plus six validated edits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;fontColor=#232F3E;fontSize=10;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=6;arcSize=6;" parent="1" vertex="1">
