        <mxCell id="n10" value="S3 ConsoleBucket&lt;br&gt;(React SPA)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="390" y="250" width="56" height="56" as="geometry" />
