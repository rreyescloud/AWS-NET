  <diagram id="stno" name="Customer architecture (generalised)">
    <mxGraphModel dx="904" dy="462" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1150" math="0" shadow="0">
      <root>
