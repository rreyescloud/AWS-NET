        <!-- Suspect areas -->
        <mxCell id="suspects" value="Likely Root Causes:&#xa;&#xa;1. IAM policy on execution role allows&#xa;   UpdateRoutingControlState only for&#xa;   RoutingControlState=On (missing Off)&#xa;&#xa;2. ARC Safety Rule blocking the Off&#xa;   (gating rule misconfigured)&#xa;&#xa;3. Timing: Step 3 evaluates before&#xa;   Step 2 propagates to all cluster&#xa;   endpoints (eventual consistency)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
